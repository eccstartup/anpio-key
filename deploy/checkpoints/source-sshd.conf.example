# Include in the source host's root-controlled sshd config. Verify with sshd -t.
# keyd-observer is a dedicated login UID, not an Agent or the daemon UID.
Match User keyd-observer
    AuthenticationMethods publickey
    PasswordAuthentication no
    KbdInteractiveAuthentication no
    AuthorizedKeysFile /etc/anpio-key/audit-authorized-keys/%u
    ForceCommand /usr/bin/sudo -n -u anpio-key -- /usr/local/libexec/anpio-key-audit-source
    DisableForwarding yes
    PermitTTY no
    PermitUserEnvironment no
    PermitUserRC no
Match all
